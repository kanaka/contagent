
COPY hostbridge-client.js /usr/local/bin/hostbridge-client.js
RUN chmod +x /usr/local/bin/hostbridge-client.js && \
    for t in paplay aplay play notify-send xdg-open pbcopy pbpaste wl-copy wl-paste xclip xsel say glimpse; do \
      ln -s hostbridge-client.js /usr/local/bin/$t; \
    done
ENV GLIMPSE_BINARY_PATH=/usr/local/bin/glimpse
