#!/usr/bin/env node
const fs = require("fs");
const path = require("path");
const cp = require("child_process");
const YAML = require("yaml");

const USAGE = `Usage: ./contagent [options] [--] [command ...]

Options:
  -c, --config CONFIG         Runtime config path (default: .contagent.yaml)
  --show-config               Print effective config and exit
  --update-config             Apply feature flags and write config file
  --<feature>                 Enable a feature
  --no-<feature>              Disable a feature
  --docker-args <args>        Extra docker run args (shell-quoted string)
  --extra-groups <gid[,gid]>  Supplementary group GIDs
  -h, --help                  Show this help
`;

const EMBEDDED = "/usr/local/share/contagent/contagent.yaml";
const VERSION = 2;
const die = (msg) => { console.error(`ERROR: ${msg}`); process.exit(1); };
const warn = (msg) => console.error(`WARN: ${msg}`);
const id = (f) => cp.execFileSync("id", [f], { encoding: "utf8" }).trim();
const isSocket = (p) => { try { return fs.statSync(p).isSocket(); } catch { return false; } };
function shellSplit(s) {
  const args = [];
  let cur = "", inSingle = false, inDouble = false, esc = false;
  for (const ch of s) {
    if (esc) { cur += ch; esc = false; }
    else if (ch === "\\" && !inSingle) esc = true;
    else if (ch === "'" && !inDouble) inSingle = !inSingle;
    else if (ch === '"' && !inSingle) inDouble = !inDouble;
    else if (/\s/.test(ch) && !inSingle && !inDouble)
      { if (cur) { args.push(cur); cur = ""; } }
    else cur += ch;
  }
  if (cur) args.push(cur);
  return args;
}

// Shared config-value expansion: leading ~ and the injected identity vars.
const expandValue = (value, vars) => {
  const v = value === "~" || value.startsWith("~/") ? vars.HOME + value.slice(1) : value;
  return v.replace(/\$\{(\w+)\}/g, (m, n) => Object.hasOwn(vars, n) ? vars[n] : m);
};
const resolvePath = (raw, vars, base) => path.resolve(base, expandValue(raw, vars));

function embeddedConfig(image) {
  const r = cp.spawnSync("docker", ["run", "--rm", "--entrypoint", "cat", image, EMBEDDED], { encoding: "utf8" });
  if (r.status !== 0) die(`failed to extract config from ${image}`);
  const doc = YAML.parse(r.stdout);
  if (!doc?.features?.length) die("embedded config is invalid");
  return doc;
}

function loadUserConfig(file) {
  if (!fs.existsSync(file)) return null;
  try {
    const doc = YAML.parse(fs.readFileSync(file, "utf8"));
    if (doc?.version && doc.version !== VERSION) die(`${file} version ${doc.version} != ${VERSION}`);
    return doc;
  } catch (e) { die(`failed to parse ${file}: ${e.message}`); }
}

function mergeConfig(embedded, user, flags) {
  const overrides = new Map((user?.features || []).filter(f => f.name).map(f => [f.name, f]));
  return embedded.features.map(ef => {
    const mf = { ...ef };
    const uf = overrides.get(ef.name);
    if (uf) {
      if ('enabled' in uf) mf.enabled = uf.enabled;
      if ('volumes' in uf) mf.volumes = uf.volumes;
      if ('environment' in uf) mf.environment = uf.environment;
      if ('ports' in uf) mf.ports = uf.ports;
    }
    if (flags.has(mf.name)) mf.enabled = flags.get(mf.name);
    return mf;
  });
}

// ---------- arg parsing (single pass) ----------

function parseArgs(argv, featureNames) {
  const flags = new Map();
  let dockerArgs = null;
  let extraGroups = null;
  let configFile = null, showConfig = false, updateConfig = false, help = false;
  let command = [], i = 0;
  while (i < argv.length) {
    const a = argv[i++];
    if (a === "--") { command = argv.slice(i); break; }
    if (a === "-h" || a === "--help") { help = true; break; }
    if (a === "--show-config") { showConfig = true; continue; }
    if (a === "--update-config") { updateConfig = true; continue; }
    if (a === "-c" || a === "--config") { configFile = argv[i++] || die("-c requires a value"); continue; }
    if (a.startsWith("--config=")) { configFile = a.slice("--config=".length); continue; }
    if (a === "--docker-args") { dockerArgs = argv[i++] || die("--docker-args requires a value"); continue; }
    if (a.startsWith("--docker-args=")) { dockerArgs = a.slice("--docker-args=".length); continue; }
    if (a === "--extra-groups") { extraGroups = argv[i++] || die("--extra-groups requires a value"); continue; }
    if (a.startsWith("--extra-groups=")) { extraGroups = a.slice("--extra-groups=".length); continue; }
    if (a.startsWith("--no-")) { const n = a.slice(5); if (!featureNames.has(n)) die(`unknown feature: ${n}`); flags.set(n, false); continue; }
    if (a.startsWith("--")) { const n = a.slice(2); if (!featureNames.has(n)) die(`unknown option: ${a}`); flags.set(n, true); continue; }
    if (a.startsWith("-")) die(`unknown option: ${a}`);
    command = argv.slice(i - 1); break;
  }
  configFile = configFile ?? process.env.CONTAGENT_CONFIG ?? ".contagent.yaml";
  dockerArgs = dockerArgs ?? process.env.CONTAGENT_DOCKER_ARGS ?? "";
  extraGroups = extraGroups ?? process.env.CONTAGENT_EXTRA_GROUP_GIDS ?? "";
  return { configFile, command, showConfig, updateConfig, help, extraGroups, flags, dockerArgs };
}

// ---------- volumes ----------

function mountPlan(features, vars, base) {
  const under = (p, dir) => p === dir || p.startsWith(dir + path.sep);
  const targets = new Map();
  for (const f of features) {
    if (!f.enabled || !f.volumes) continue;
    for (const v of f.volumes) {
      const src = resolvePath(v.source || v.path, vars, base);
      const tgt = resolvePath(v.path, vars, base);
      if (!targets.has(tgt)) targets.set(tgt, []);
      // Create missing sources only when user-scoped: under home or the project cwd.
      const c = { src, file: !!v.file, ro: !!v.read_only, create: under(src, vars.HOME) || under(src, base) };
      if (!targets.get(tgt).some(x => x.src === c.src)) targets.get(tgt).push(c);
    }
  }
  const specs = [], gids = [];
  for (const [tgt, cands] of targets) {
    let c = cands.find(c => fs.existsSync(c.src));
    if (!c) {
      c = cands.find(c => c.create);
      if (!c) die(`no source for mount ${tgt}`);
      if (c.file) {
        fs.mkdirSync(path.dirname(c.src), { recursive: true });
        fs.closeSync(fs.openSync(c.src, "a"));
      } else {
        fs.mkdirSync(c.src, { recursive: true });
      }
    }
    try { const st = fs.statSync(c.src); if (st.isSocket() && !gids.includes(String(st.gid))) gids.push(String(st.gid)); } catch {}
    specs.push(`${c.src}:${tgt}${c.ro ? ":ro" : ""}`);
  }
  return { specs, gids };
}

function extraGroupSpecs(csv) {
  const gids = [];
  for (const t of csv ? csv.split(",") : []) {
    const g = t.trim();
    if (!g) continue;
    if (!/^\d+$/.test(g)) warn(`ignoring non-numeric gid: ${g}`);
    else if (!gids.includes(g)) gids.push(g);
  }
  return gids.map(g => `g${g}:${g}`).join(",");
}

// ---------- main ----------

function main() {
  if (cp.spawnSync("docker", ["--version"], { stdio: "ignore" }).error) die("docker is required");
  const image = process.env.CONTAGENT_IMAGE || "contagent:latest";
  const home = process.env.HOME || die("HOME must be set");
  const cwd = process.cwd();

  const embedded = embeddedConfig(image);
  const featureNames = new Set(embedded.features.map(f => f.name));
  const p = parseArgs(process.argv.slice(2), featureNames);
  if (p.help) { process.stdout.write(USAGE + "\n"); return; }

  const features = mergeConfig(embedded, loadUserConfig(p.configFile), p.flags);

  if (p.showConfig) {
    process.stdout.write(YAML.stringify({ version: VERSION, features }));
    return;
  }
  if (p.updateConfig) {
    if (!p.flags.size) die("--update-config requires feature flags");
    const diff = features.filter(mf => {
      const ef = embedded.features.find(f => f.name === mf.name);
      return p.flags.has(mf.name) || !ef || mf.enabled !== ef.enabled
        || JSON.stringify(mf.volumes) !== JSON.stringify(ef.volumes)
        || JSON.stringify(mf.environment) !== JSON.stringify(ef.environment)
        || JSON.stringify(mf.ports) !== JSON.stringify(ef.ports);
    });
    fs.mkdirSync(path.dirname(p.configFile), { recursive: true });
    fs.writeFileSync(p.configFile, YAML.stringify({ version: VERSION, features: diff }));
    console.error(`wrote ${p.configFile}`);
    return;
  }

  // Docker args
  const args = ["run", "--rm", "--workdir", cwd, "--volume", `${cwd}:${cwd}`];
  if (process.stdin.isTTY && process.stdout.isTTY) args.push("--interactive", "--tty");

  const identity = {
    CONTAGENT_USERNAME: process.env.USER || id("-un"),
    CONTAGENT_GROUPNAME: id("-gn"),
    CONTAGENT_UID: id("-u"),
    CONTAGENT_GID: id("-g"),
    CONTAGENT_HOME: home,
    CONTAGENT_CWD: cwd,
  };
  // Expansion vocabulary is exactly what contagent injects; host env never leaks.
  const expandVars = { ...identity, HOME: home, PWD: cwd, USER: identity.CONTAGENT_USERNAME };
  const envs = [
    ...Object.entries(identity),
    ...(process.env.TERM ? [["TERM", process.env.TERM]] : []),
    ...(process.env.COLORTERM ? [["COLORTERM", process.env.COLORTERM]] : []),
  ];
  for (const f of features) if (f.enabled) for (let [k, v] of Object.entries(f.environment || {})) {
    if (k === "CONTAGENT_CWD") die("CONTAGENT_CWD is reserved");
    if (typeof v === "number" || typeof v === "boolean") v = String(v);
    if (typeof v !== "string") { warn(`feature ${f.name}: ignoring non-string environment value for ${k} (unquoted ~ is YAML null)`); continue; }
    if (v.startsWith("./") || v.startsWith("../"))
      warn(`feature ${f.name}: ${k} is passed literally; use \${PWD}/... for a launch-dir-relative path`);
    envs.push([k, expandValue(v, expandVars)]);
  }
  for (const f of features) if (f.enabled) for (const p of f.ports || []) args.push("--publish", String(p));
  for (const [k, v] of envs) args.push("--env", `${k}=${v}`);

  const { specs, gids } = mountPlan(features, expandVars, cwd);
  for (const s of specs) args.push("--volume", s);
  const ssh = process.env.SSH_AUTH_SOCK || "";
  if (ssh && isSocket(ssh)) args.push("--volume", `${ssh}:${ssh}`, "--env", `SSH_AUTH_SOCK=${ssh}`);
  else warn("SSH agent not available; SSH auth forwarding disabled");
  const groups = extraGroupSpecs([p.extraGroups, ...gids].filter(Boolean).join(","));
  if (groups) args.push("--env", `CONTAGENT_EXTRA_GROUP_SPECS=${groups}`);
  if (p.dockerArgs) args.push(...shellSplit(p.dockerArgs));

  const hb = features.find(f => f.name === "hostbridge")?.enabled;
  if (hb) {
    require("./hostbridge.js").start({ logFile: ".hostbridge-log" }).then(({ port, shutdown }) => {
      args.push("--env", `HOSTBRIDGE_PORT=${port}`);
      run(args, image, p.command, shutdown);
    }).catch(e => die(e.message));
  } else run(args, image, p.command);
}

function run(args, image, command, shutdown) {
  const docker = cp.spawn("docker", [...args, image, ...command], { stdio: "inherit" });
  docker.on("close", code => {
    const exit = () => process.exit(typeof code === "number" ? code : 1);
    shutdown ? shutdown().then(exit) : exit();
  });
  docker.on("error", e => die(e.message));
  for (const s of ["SIGINT", "SIGTERM"]) process.on(s, () => docker.kill(s));
}

main();
